# =============================================================================
# CMED Frontend — Development Dockerfile
# =============================================================================
# Uses Vite dev server with Hot Module Replacement (HMR).
# Volume-mounted in docker-compose.dev.yml for live code reloading.
# No build step — code changes reflect instantly in the browser.
# =============================================================================

FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source (will be overridden by volume mount in dev compose)
COPY . .

# Expose Vite dev server port
EXPOSE 3000

# Run Vite dev server — bind to 0.0.0.0 so it's accessible from host
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
